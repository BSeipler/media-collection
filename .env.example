# Turso Cloud (libSQL) — free tier
# URL: https://media-collection-bseipler.aws-us-east-1.turso.io
# Create a token: turso db tokens create media-collection
TURSO_DATABASE_URL=libsql://media-collection-bseipler.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=

# Shared password gate (leave empty to disable locally)
APP_PASSWORD=changeme

# TMDB — https://www.themoviedb.org/settings/api (free, non-commercial)
TMDB_API_KEY=

# eBay Browse API — https://developer.ebay.com/ (free ~5k calls/day)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
